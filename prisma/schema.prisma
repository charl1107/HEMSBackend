datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  passwordHash      String
  firstName         String
  middleName        String?
  lastName          String
  suffix            String?
  isActive          Boolean           @default(true)
  userRoles         UserRole[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  createdEvents     Event[]
  // LEGACY: not used by the app; table kept so existing rows survive.
  approvals         Approval[]
  // LEGACY: not used by the app; table kept so existing rows survive.
  participants      Participant[]
  committeeMemberships CommitteeMember[]
  assignedTasks     EventTask[]
  documents         Document[]
  notifications     Notification[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  studentId         String?           @unique
  program           String?
  yearLevel         Int?
  mustChangePassword Boolean          @default(false)
}

enum NotificationType {
  EventSubmitted
  EventApproved
  EventRejected
  RevisionRequested
  TaskAssigned
}

// LEGACY: not used by the app; table kept so existing rows survive.
enum ApprovalAction {
  Submitted
  Approved
  Rejected
  RevisionRequested
}

enum EventStatus {
  Draft
  PendingApproval
  RevisionRequired
  Approved
  Rejected
  Planning
  Ongoing
  Completed
  Cancelled
}

enum EventCampusScope {
  OnCampus
  OffCampus
}

model EventType {
  id     String  @id @default(cuid())
  name   String  @unique
  events Event[]
}

model Event {
  id            String      @id @default(cuid())
  title         String
  description   String?
  eventDate     DateTime    @db.Date
  venue         String
  department    String?
  campusScope   EventCampusScope @default(OnCampus)
  status        EventStatus @default(Draft)
  coverImageUrl String?
  eventTypeId   String?
  eventType     EventType?  @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  // LEGACY: not used by the app; table kept so existing rows survive.
  approvals     Approval[]
  // LEGACY: not used by the app; table kept so existing rows survive.
  participants  Participant[]
  committees    Committee[]
  tasks         EventTask[]
  scheduleEntries EventSchedule[]
  attendance    Attendance[]
  documents     Document[]
  notifications Notification[]

  @@index([status])
  @@index([eventDate])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, createdAt])
}

enum AttendanceStatus {
  Present
  Absent
}

model Attendance {
  id             String           @id @default(cuid())
  participantId  String
  participant    Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  timeIn         DateTime?
  timeOut        DateTime?
  status         AttendanceStatus
  clientRecordId String?          @unique
  syncedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([eventId, participantId])
  @@index([eventId])
  @@index([participantId])
}

enum TaskStatus {
  Todo
  InProgress
  Done
}

model EventTask {
  id               String     @id @default(cuid())
  eventId          String
  event            Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  assignedToUserId String?
  assignedToUser   User?      @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  deadline         DateTime
  status           TaskStatus @default(Todo)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([eventId])
  @@index([assignedToUserId])
}

model EventSchedule {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activityName String
  startTime    DateTime
  endTime      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([eventId])
}

// LEGACY: not used by the app; table kept so existing rows survive.
model Approval {
  id         String         @id @default(cuid())
  eventId    String
  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reviewerId String?
  reviewer   User?          @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  action     ApprovalAction
  comments   String?
  createdAt  DateTime       @default(now())

  @@index([eventId, createdAt])
}

// LEGACY: not used by the app; table kept so existing rows survive.
enum ParticipantType {
  Student
  Staff
  Guest
}

// LEGACY: not used by the app; table kept so existing rows survive.
enum RegistrationStatus {
  Registered
}

// LEGACY: not used by the app; table kept so existing rows survive.
model Participant {
  id                 String             @id @default(cuid())
  eventId            String
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalName       String?
  participantType    ParticipantType
  registrationStatus RegistrationStatus @default(Registered)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  attendance         Attendance[]

  @@unique([eventId, userId])
  @@index([eventId])
}

model Committee {
  id          String            @id @default(cuid())
  eventId     String
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String?
  members     CommitteeMember[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([eventId, name])
  @@index([eventId])
}

model CommitteeMember {
  id          String   @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([committeeId, userId])
  @@index([userId])
}

model Role {
  id    String     @id @default(cuid())
  name  String     @unique
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum DocType {
  Proposal
  Program
  Certificate
  Photo
  Report
}

model Document {
  id               String   @id @default(cuid())
  eventId          String
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedById     String?
  uploadedBy       User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  docType          DocType
  filePath         String
  originalFilename String
  mimeType         String
  fileSize         Int
  createdAt        DateTime @default(now())

  @@index([eventId])
  @@index([uploadedById])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  method    String
  path      String
  body      Json?
  statusCode Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
