# Copy to .env and fill in real values. Never commit .env.

# --- Database (required, Prisma) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hems?schema=public"
# Point pooler/direct connection if using a hosted Postgres (e.g. Supabase)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/hems?schema=public"

# --- Auth (required) ---
# Refuses empty, "dev-secret-change-me", or the legacy placeholder in ALL environments.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# --- Server (optional) ---
# NODE_ENV="development"
# PORT=3000

# --- CORS (comma-separated explicit origins, "*" forbidden) ---
# REQUIRED when NODE_ENV=production; unset disables CORS (credentials off) in dev.
# FRONTEND_URL="https://your-app.vercel.app"

# --- Supabase document storage (optional; document upload falls back when unset) ---
# SUPABASE_URL="https://PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="event-documents"

# --- Seed admin (optional; prisma/seed skips admin provisioning when unset) ---
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD=""
